{% macro renderTree(tree, currentPath="/") %}

  {% set childOrder = navigationOrder[currentPath] or [] %}

  <ul>

    {# --- FIRST PASS: ordered items --- #}
    {% for orderedName in childOrder %}
      {% for key, fileOrFolder in tree %}

        {# Safely determine display name #}
        {% set name = fileOrFolder.name or key | replace(".md", "") | replace(".md", "") %}

        {% if name == orderedName %}
          <li>
            {% if fileOrFolder.children %}
              <details>
                <summary>{{ name }}</summary>
                {{ renderTree(fileOrFolder.children, currentPath + "/" + name) }}
              </details>
            {% else %}
              <a href="{{ fileOrFolder.url }}">{{ name }}</a>
            {% endif %}
          </li>
        {% endif %}

      {% endfor %}
    {% endfor %}

    {# --- SECOND PASS: everything else --- #}
    {% for key, fileOrFolder in tree %}

      {% set name = fileOrFolder.name or key | replace(".md", "") | replace(".md", "") %}

      {% if name not in childOrder %}
        <li>
          {% if fileOrFolder.children %}
            <details>
              <summary>{{ name }}</summary>
              {{ renderTree(fileOrFolder.children, currentPath + "/" + name) }}
            {% else %}
              <a href="{{ fileOrFolder.url }}">{{ name }}</a>
            {% endif %}
          </li>
      {% endif %}

    {% endfor %}

  </ul>

{% endmacro %}
